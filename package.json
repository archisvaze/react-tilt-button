{
    "name": "react-tilt-button",
    "version": "0.2.1",
    "description": "A physical, 3D tactile React button with tilt, squish, spring physics and real depth.",
    "license": "MIT",
    "author": "archisvaze",
    "keywords": [
        "react",
        "react-component",
        "button",
        "3d-button",
        "tilt",
        "tactile",
        "spring",
        "squish",
        "animation",
        "ui"
    ],
    "homepage": "https://react-tilt-button.vercel.app/",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/archisvaze/react-tilt-button.git"
    },
    "bugs": {
        "url": "https://github.com/archisvaze/react-tilt-button/issues"
    },
    "files": [
        "dist",
        "README.md"
    ],
    "main": "./dist/react-tilt-button.umd.js",
    "module": "./dist/react-tilt-button.es.js",
    "exports": {
        ".": {
            "import": "./dist/react-tilt-button.es.js",
            "require": "./dist/react-tilt-button.umd.js"
        }
    },
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "test": "vitest run",
        "watch": "vitest",
        "coverage": "vitest run --coverage"
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
    "eslintConfig": {
        "env": {
            "browser": true,
            "node": true,
            "es2020": true
        },
        "extends": [
            "eslint:recommended",
            "plugin:react/recommended"
        ],
        "parserOptions": {
            "sourceType": "module"
        }
    },
    "devDependencies": {
        "@vitejs/plugin-react": "^5.1.2",
        "react": "^19.2.3",
        "react-dom": "^19.2.3",
        "vite": "^7.3.1",
        "vite-plugin-css-injected-by-js": "^3.5.2"
    },
    "peerDependencies": {
        "react": "^18.0.0 || ^19.0.0",
        "react-dom": "^18.0.0 || ^19.0.0"
    }
}
